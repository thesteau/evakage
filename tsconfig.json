{
  // Type checking only. TypeScript never emits: the browser loads the same
  // hand-written ES modules it always did, so there is no build step and no
  // shipped dependency. Types come from JSDoc annotations plus inference.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["node"],

    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    // Ratchet, not a destination. Everything below is enforced and green today.
    // strictNullChecks and noImplicitAny are both enabled. Next step:
    // strictFunctionTypes, then the DOM handles in public/app.js (the `$` helper
    // still returns `any`, which is the largest remaining hole).
    // Counts change as the code evolves; remeasure before each pass.
    // Tracked in TODO.md. Raise one flag at a time and fix, rather than turning
    // on `strict` and suppressing what falls out.
    "strict": false,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,

    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false
  },
  "include": ["server.js", "blobstore.js", "public/**/*.js", "tests/**/*.js", "e2e/**/*.js", "playwright.config.js", "eslint.config.js"],
  "exclude": ["node_modules"]
}
