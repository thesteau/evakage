{
  // Type checking only. TypeScript never emits: the browser loads the same
  // hand-written ES modules it always did, so there is no build step and no
  // shipped dependency. Types come from JSDoc annotations plus inference.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["node"],

    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    // Ratchet, not a destination. Everything below is enforced and green today.
    // Next steps, in order: `strictNullChecks` (52 findings, where the real bugs
    // are) then `noImplicitAny` (388, mostly mechanical JSDoc on parameters).
    // Tracked in TODO.md. Raise one flag at a time and fix, rather than turning
    // on `strict` and suppressing what falls out.
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noImplicitThis": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,

    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false
  },
  "include": ["server.js", "blobstore.js", "public/**/*.js", "tests/**/*.js", "eslint.config.js"],
  "exclude": ["node_modules"]
}
