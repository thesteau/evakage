{
  "name": "evakage",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-first ephemeral peer chat and file transfer for trusted networks.",
  "license": "MIT",
  "author": "thesteau",
  "homepage": "https://github.com/thesteau/aria-drop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thesteau/aria-drop.git"
  },
  "bugs": {
    "url": "https://github.com/thesteau/aria-drop/issues"
  },
  "type": "module",
  "scripts": {
    "start": "node app/server/server.js",
    "dev": "node --watch app/server/server.js",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "playwright test --config app/playwright.config.js",
    "test:e2e:platform": "playwright test --config app/playwright.platform.config.js",
    "lint": "eslint --config app/eslint.config.js .",
    "typecheck": "tsc --noEmit -p app/tsconfig.json",
    "typecheck:release": "tsc --noEmit -p scripts/tsconfig.json",
    "test:release": "node --test \"tests/release/*.test.cts\"",
    "check": "npm run lint && npm run typecheck && npm run typecheck:release && npm test && npm run test:release"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsqr": "1.4.0",
    "qrcode-generator": "2.0.4",
    "release-please": "17.11.2",
    "typescript": "^7.0.2"
  }
}
