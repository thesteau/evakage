{
  "name": "aria-drop",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-first ephemeral peer chat and file transfer for trusted networks.",
  "license": "MIT",
  "author": "thesteau",
  "homepage": "https://github.com/thesteau/aria-drop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thesteau/aria-drop.git"
  },
  "bugs": {
    "url": "https://github.com/thesteau/aria-drop/issues"
  },
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "test:e2e": "playwright test",
    "test:e2e:platform": "playwright test --config playwright.platform.config.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.2"
  }
}
