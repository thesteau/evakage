# Copy to .env next to docker-compose.yml. The file is required; every value in
# it is optional.

# Require a token for the page and the WebSocket. Open https://host/?token=...
# once and it is exchanged for an HttpOnly session cookie.
AUTH_TOKEN=

# Largest file one transfer may carry (default 512 MiB).
# MAX_FILE_BYTES=536870912

# SQLite accounts database; leave empty (ACCOUNTS_DB=) to disable accounts.
# ACCOUNTS_DB=/home/node/evakage-accounts/accounts.sqlite

# Set to 1 only behind a reverse proxy you control.
TRUST_PROXY=0

# Exact origins allowed to open the WebSocket, comma separated.
ALLOWED_ORIGINS=

# STUN/TURN servers for networks where direct connections struggle. Not needed
# for transfers to work: the server relay covers that case on its own.
ICE_SERVERS_JSON=[]

# Seats per room (2-64, default 20). Rooms of up to six connect members directly;
# larger ones run entirely through the server relay.
ROOM_MAX_MEMBERS=20

# --- server relay (messages and files) ---
# Relay expiry limits, in milliseconds.
# How long an item stays available after all conversation participants disconnect.
BLOB_IDLE_GRACE_MS=900000
# How long a direct chat may have only one device online before its relay items expire.
# Rooms are exempt. Also how long an offline device stays listed as reachable.
BLOB_SOLO_MAX_MS=10800000
# Maximum item age, even while participants are online (default 3 days).
BLOB_MAX_AGE_MS=259200000
# How often the sweep runs; it also removes empty conversation directories.
BLOB_SWEEP_MS=60000
# Total space all relayed items may use together (default 4 GiB).
BLOB_STORE_BYTES=4294967296
# Text has a separate budget (capped at one quarter of the total).
BLOB_TEXT_RESERVE_BYTES=1073741824
# Per-chat ceilings; the smaller server-wide budgets still apply.
BLOB_CHAT_FILE_BYTES=53687091200
BLOB_CHAT_TEXT_BYTES=1073741824
MAX_DEVICES=200
MAX_ROOMS=50
# Files one device may have waiting on the server at once (default 32).
BLOB_PER_DEVICE=32
# Messages one device may have waiting on the server at once (default 2000).
BLOB_MESSAGES_PER_DEVICE=2000
