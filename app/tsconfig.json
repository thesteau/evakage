{
  // Type checking only. TypeScript never emits: the browser loads the same
  // hand-written ES modules it always did, so there is no build step and no
  // shipped dependency. Types come from JSDoc annotations plus inference.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["node"],

    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    // Ratchet, not a destination. Everything below is enforced and green today.
    // strictNullChecks, noImplicitAny and strictFunctionTypes are enabled.
    // App DOM handles use concrete element types. Raise further flags one at
    // a time and fix findings; track remaining work in TODO.md.
    "strict": false,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitThis": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,

    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false
  },
  "include": ["server/**/*.js", "public/**/*.js", "tests/**/*.js", "e2e/**/*.js", "playwright.config.js", "playwright.platform.config.js", "eslint.config.js"],
  "exclude": ["../node_modules", "public/vendor/jsqr.js"]
}
