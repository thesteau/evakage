# Copy to app/.env for the source Compose build.
# Node commands read the shell environment; export these values when running
# without Compose. Keep PORT=3000 to match the Compose port mapping.
PORT=3000
HOST=0.0.0.0
MAX_FILE_BYTES=536870912
ICE_SERVERS_JSON=[]

# Require a token for the page and the WebSocket. Open https://host/?token=...
# once and the server trades it for an HttpOnly session cookie. /healthz stays
# open so the container healthcheck keeps working. Unset means no auth.
AUTH_TOKEN=

# Exact origins allowed to open the WebSocket, comma separated. Unset means the
# origin must match the request's own host, which is what you want behind a
# normal reverse proxy.
ALLOWED_ORIGINS=

# Set to 1 ONLY when a proxy you control is in front. It makes the server trust
# X-Forwarded-Host for origin checks and X-Forwarded-For for per-address limits.
# Leave it off if clients can reach this port directly, or they can spoof both.
TRUST_PROXY=0

# Docker persists accounts in the named account-data volume by default.
# Set ACCOUNTS_DB= to disable accounts; for local Node use a path such as
# ACCOUNTS_DB=./data/accounts.sqlite
